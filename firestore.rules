rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Seguridad mínima para demo / presentación
    // Reglas pensadas para entornos de staging/preview. Ajustar antes de producción.

    // Usuarios: cada usuario puede leer y escribir su propio documento
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Viajes: lectura para usuarios autenticados; creación/actualización controlada por conductor
    match /trips/{tripId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.conductorId == request.auth.uid
                    && request.resource.data.asientosDisponibles is int
                    && request.resource.data.asientosDisponibles >= 0
                    && request.resource.data.estado in ["PROGRAMADO", "CANCELADO"];

      allow update: if request.auth != null
                    && resource.data.conductorId == request.auth.uid;

      allow delete: if false;

      // Subcolección de solicitudes a un viaje
      match /requests/{requestId} {
        // Lectura permitida al pasajero autor de la solicitud o al conductor del viaje
        allow read: if request.auth != null && (
          resource.data.pasajeroId == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.conductorId == request.auth.uid
        );

        // Crear solicitud: solo el pasajero puede crear su propia solicitud y debe venir en estado PENDIENTE
        allow create: if request.auth != null
                      && request.resource.data.pasajeroId == request.auth.uid
                      && request.resource.data.estado == "PENDIENTE";

        // Actualizar solicitud: solo el conductor puede actualizar el estado (ACEPTADO/RECHAZADO)
        allow update: if request.auth != null && (
          // conductor aceptando/rechazando
          get(/databases/$(database)/documents/trips/$(tripId)).data.conductorId == request.auth.uid
          // o pasajero actualizando campos de su propia solicitud (no estado)
          || resource.data.pasajeroId == request.auth.uid
        ) && (
          // si se cambia a ACEPTADO, validar que el estado solicitado sea ACEPTADO o RECHAZADO
          (request.resource.data.estado in ["ACEPTADO", "RECHAZADO"]) ||
          // pasajeros no pueden cambiar a ACEPTADO
          (resource.data.pasajeroId == request.auth.uid && request.resource.data.estado == resource.data.estado)
        );

        allow delete: if false;
      }
    }

    // Permitir lecturas por collectionGroup para que los pasajeros puedan listar
    // sus solicitudes sin depender de la ruta completa del documento padre.
    // Esto evita PERMISSION_DENIED en consultas collectionGroup("requests").
    match /{document=**}/requests/{requestId} {
      allow read: if request.auth != null && resource.data.pasajeroId == request.auth.uid;
      // Crear/actualizar/eliminar siguen controlados por la regla específica dentro de /trips/{tripId}
    }

    // Denegar todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
