rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /trips/{tripId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.conductorId == request.auth.uid
                    && request.resource.data.asientosDisponibles > 0
                    && request.resource.data.estado == "PROGRAMADO";

      allow update: if request.auth != null
                    && resource.data.conductorId == request.auth.uid;

      allow delete: if false;

      match /requests/{requestId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
                      && request.resource.data.pasajeroId == request.auth.uid
                      && request.resource.data.estado == "PENDIENTE";

        allow update: if request.auth != null
                      && get(/databases/$(database)/documents/trips/$(tripId))
                         .data.conductorId == request.auth.uid;

        allow delete: if false;
      }
    }
  }
}
