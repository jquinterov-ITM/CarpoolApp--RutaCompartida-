<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_mis_viajes"
    app:startDestination="@id/misViajesFragment">

    <fragment
        android:id="@+id/misViajesFragment"
        android:name="com.carpoolapp.ui.mis_viajes.MisViajesFragment"
        android:label="Mis Viajes">
        <action
            android:id="@+id/action_misViajes_to_solicitudes"
            app:destination="@id/solicitudesFragment" />
        <action
            android:id="@+id/action_misViajes_to_detalle"
            app:destination="@id/viajeDetalleFragment" />
    </fragment>

    <fragment
        android:id="@+id/solicitudesFragment"
        android:name="com.carpoolapp.ui.solicitudes.SolicitudesFragment"
        android:label="Solicitudes">
        <argument
            android:name="tripId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/viajeDetalleFragment"
        android:name="com.carpoolapp.ui.detalle.ViajeDetalleFragment"
        android:label="Detalle del Viaje">
        <argument
            android:name="tripId"
            app:argType="string" />
        <argument
            android:name="esConductor"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

</navigation>
